generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Define o provedor como PostgreSQL
  url      = env("DATABASE_URL") // Lê a string de conexão do arquivo .env
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  posts Post[]
}

model Post {
  id       Int     @id @default(autoincrement())
  title    String
  content  String
  author   User    @relation(fields: [authorId], references: [id])
  authorId Int
}

